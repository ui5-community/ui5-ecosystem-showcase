sap.ui.define([
  "{{webcBaseClass}}",{{#if needsLabelEnablement}}
  "sap/ui/core/LabelEnablement",{{/if}}{{#if needsEnabledPropagator}}
  "sap/ui/core/EnabledPropagator",{{/if}}{{#if needsMessageMixin}}
  "sap/ui/core/message/MessageMixin",{{/if}}
  "{{namespace}}",{{#if importWebCModule}}
  "{{webcClass}}",{{/if}}
], function(
  {{webcBaseClassName}},{{#if needsLabelEnablement}}
  LabelEnablement,{{/if}}{{#if needsEnabledPropagator}}
  EnabledPropagator,{{/if}}{{#if needsMessageMixin}}
  MessageMixin,{{/if}}
) {
  "use strict";

{{{jsDocClassHeader}}}
  const {{ui5ClassSimpleName}} = {{webcBaseClassName}}.extend("{{ui5ClassName}}", {
    metadata:
{{{metadata}}}
  });
  {{#if needsLabelEnablement}}
  LabelEnablement.enrich({{ui5ClassSimpleName}}.prototype);{{/if}}{{#if needsEnabledPropagator}}
  EnabledPropagator.call({{ui5ClassSimpleName}}.prototype);{{/if}}{{#if needsMessageMixin}}
  MessageMixin.call({{ui5ClassSimpleName}}.prototype);{{/if}}

  return {{ui5ClassSimpleName}};

});
