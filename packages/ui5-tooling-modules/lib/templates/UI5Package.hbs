/*!
 * ${copyright}
 */
sap.ui.define([{{#if webcPackage}}
  "{{webcPackage}}",{{/if}}{{#if isBaseLib}}
  "sap/ui/core/webc/WebComponent",{{/if}}{{#if hasEnums}}
  "sap/ui/base/DataType",{{/if}}{{#each dependencies}}
  "{{this}}",{{/each}}
], function({{#if webcPackage}}
  WebCPackage,{{/if}}{{#if isBaseLib}}
  WebComponent,{{/if}}{{#if hasEnums}}
  DataType,{{/if}}
) {
  "use strict";
  {{#if hasEnums}}
  const { registerEnum } = DataType;
  {{/if}}

	// re-export package object
  const pkg = {{#if webcPackage}}Object.assign({}, WebCPackage){{else}}{}{{/if}};

	// export the UI5 metadata along with the package
	pkg["_ui5metadata"] = {{{metadata}}};

	// Enums
  {{! Enums are placed at their derived access path (e.g. pkg.dist.types.GeomapSelectionMode) }}
  {{! so the JS object path matches the UI5 qualified name, the registerEnum call and the JSDoc @alias. The }}
  {{! parent namespaces are re-cloned first because "pkg" is a shallow copy of the frozen web component bundle. }}
  {{#each enumNamespaceEnsures}}
  {{{this}}}
  {{/each}}
  {{#each enums}}
  {{{this._jsDoc}}}
  {{{this._accessorExpr}}} = {
  {{#each this.values}}
    {{this._jsDoc}}
    "{{this.name}}": "{{this.value}}",
  {{/each}}
  };
  registerEnum("{{this._ui5QualifiedName}}", {{{this._accessorExpr}}});
  {{/each}}
  {{#if enumLegacyExports}}
  {{! Compat (pluginOptions/webcomponents/compat/legacyEnumExport): re-export each enum under its original }}
  {{! flat key pointing at the same nested object, so pre-nesting consumers keep working at runtime. }}
  {{#each enumLegacyExports}}
  {{{this}}}
  {{/each}}
  {{/if}}

  // Interfaces
  {{#each interfaces}}
  {{{this._jsDoc}}}
  {{/each}}

  {{#if isBaseLib}}
  // ====================
  // MONKEY PATCHES BEGIN
  // ====================
{{{monkeyPatches}}}
  // ====================
  // MONKEY PATCHES END
  // ====================
  {{/if}}

	// marker to threat this as an ES module to support named exports
	pkg.__esModule = true;

  return pkg;
});
