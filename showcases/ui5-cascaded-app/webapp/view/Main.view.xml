<mvc:View
  controllerName="ui5.ecosystem.demo.cascaded.app.controller.Main"
  displayBlock="true"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns:webc="@ui5/webcomponents/dist"
  xmlns:fiori="@ui5/webcomponents-fiori/dist"
>
  <Page id="page" title="{i18n>appTitle}">
    <headerContent>
      <core:Icon color="#1873B4" src="sap-icon://sap-ui5" size="2rem" />
    </headerContent>
    <content>
      <VBox alignItems="Center" justifyContent="Center" height="100%" class="sapUiContentPadding">
        <!-- Button: bundled by the producer library, reused here -->
        <webc:Button design="Emphasized" text="Press me (from producer)" click=".onPress" />
        <!-- Input: @ui5/webcomponents package, but bundled by the consumer library -->
        <webc:Input id="input" placeholder="Type something (from consumer)" />
        <!-- Search: bundled by the consumer library -->
        <fiori:Search id="search" placeholder="Search (from consumer)" />
      </VBox>
    </content>
  </Page>
</mvc:View>
