{
  "name": "ui5-cascaded-app",
  "version": "0.0.1",
  "description": "Cascaded build showcase: demo app consuming the producer and consumer libraries (Button, Search, Input)",
  "private": true,
  "author": "Peter Muessig",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rimraf dist",
    "build": "ui5 build --clean-dest",
    "start": "ui5 serve --config ui5-dist.yaml --port 1339 --open index.html",
    "dev": "ui5 serve --port 1339 --open index.html",
    "lint": "eslint webapp"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ui5-community/ui5-ecosystem-showcase.git",
    "directory": "showcases/ui5-cascaded-app"
  },
  "dependencies": {
    "ui5-cascaded-consumer": "workspace:^",
    "ui5-cascaded-producer": "workspace:^"
  },
  "devDependencies": {
    "@ui5/cli": "^4.0.55",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "rimraf": "^6.1.3",
    "ui5-middleware-serveframework": "workspace:^",
    "ui5-tooling-modules": "workspace:^",
    "ui5-tooling-transpile": "workspace:^"
  }
}
