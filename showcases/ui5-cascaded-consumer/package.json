{
  "name": "ui5-cascaded-consumer",
  "version": "0.0.1",
  "description": "Cascaded build showcase: consumer library that reuses the producer's bundled @ui5/webcomponents",
  "private": true,
  "author": "Peter Muessig",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rimraf dist",
    "build": "ui5 build --clean-dest",
    "dev": "ui5 serve --port 8081 -o test-resources/ui5/ecosystem/demo/cascaded/consumer/TestPage.html",
    "start": "ui5 serve --port 8081 -o test-resources/ui5/ecosystem/demo/cascaded/consumer/TestPage.html --config ui5-dist.yaml"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ui5-community/ui5-ecosystem-showcase.git",
    "directory": "showcases/ui5-cascaded-consumer"
  },
  "devDependencies": {
    "@ui5/cli": "^4.0.55",
    "rimraf": "^6.1.3",
    "ui5-cascaded-producer": "workspace:^",
    "ui5-tooling-modules": "workspace:^"
  },
  "dependencies": {
    "@ui5/webcomponents-fiori": "^2.23.1"
  }
}
